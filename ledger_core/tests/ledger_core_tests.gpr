with "config/ledger_core_tests_config.gpr";
with "ledger_core.gpr";
project Ledger_Core_Tests is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Ledger_Core_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ledger_Core_Tests_Config.Ada_Compiler_Switches & ("-gnatwa");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Ledger_Core_Tests;
