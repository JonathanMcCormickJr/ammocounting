<% content_for :title, "Sign in" %>
<h1>Sign in</h1>

<%= form_with url: session_path do |form| %>
  <p><%= form.label :email_address, "Email" %>
  <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %></p>
  <p><%= form.label :password, "Password" %>
  <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %></p>
  <%= form.submit "Sign in" %>
<% end %>

<p>New here? <%= link_to "Create an account", new_signup_path %></p>
